local function findPlayerByName(name)
    local l = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == l or p.DisplayName:lower() == l then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
