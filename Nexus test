RunService:BindToRenderStep("NexusMain", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if unloaded then return end
    Camera = Workspace.CurrentCamera or Camera
    refreshMe()
    fps = fps * 0.9 + (1 / math.max(dt, 1e-3)) * 0.1

    local alive = hum ~= nil and root ~= nil and hum.Health > 0
    if alive then
        movementStep(dt)
        if lock.active then lockStep(dt) end
        maceStep(dt)   -- Auto-Mace (HvH из старого скрипта)
        critStep(dt)   -- Auto-Crit
        antiaimStep(dt)
        autododgeStep(dt)
        spin360Step(dt)
        fakelagStep(dt)
        camThirdStep(dt)
    else
        if mace.active or crit.active or lock.active then stopMace(true); stopCrit(true); lockRelease(true) end
        flyOn = false
        clearFakelagGhosts()
    end

    if CFG.customFov then Camera.FieldOfView = CFG.camFov; camFovTouched = true
    elseif camFovTouched then Camera.FieldOfView = 70; camFovTouched = false end

    markerStep()
    hudStep()

    slowT = slowT + dt
    if slowT >= 0.1 then slowT = 0; slowStep() end
end)

