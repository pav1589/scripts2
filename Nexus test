local camThirdPart = new("Part", { Name = "NexusCameraPart", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CanCollide = false, Anchored = true, CanQuery = false, CanTouch = false, Parent = Workspace })

local function camThirdStep(dt)
    if not CFG.camThirdEnabled or not root then
        camThirdPart.Parent = nil
        return
    end
    camThirdPart.Parent = Workspace
    local basePos = root.Position + Vector3.new(0, CFG.camThirdHeight, 0)

    if CFG.camThirdAim then
        local t = pickTarget(false)
        if t then
            local _, _, r = getChar(t)
            if r then
                local dir = (r.Position - basePos).Unit
                local camPos = basePos - dir * CFG.camThirdRadius
                camThirdPart.CFrame = CFrame.new(camPos)
                local look = CFrame.lookAt(camPos, r.Position)
                Camera.CFrame = Camera.CFrame:Lerp(look, math.clamp(CFG.camThirdSmooth * 60 * dt, 0, 1))
                return
            end
        end
    end
    local dir = Camera.CFrame.LookVector
    local camPos = basePos - dir * CFG.camThirdRadius
    camThirdPart.CFrame = CFrame.new(camPos)
    local look = CFrame.lookAt(camPos, basePos + dir)
    Camera.CFrame = Camera.CFrame:Lerp(look, math.clamp(CFG.camThirdSmooth * 60 * dt, 0, 1))
end

