local function antiaimStep(dt)
    if not CFG.antiaimEnabled or not hum or hum.Health <= 0 then return end
    if CFG.antiaimMode == "Jitter" then
        antiaim.ang = antiaim.ang + CFG.antiaimSpeed * dt * 60
        local yaw = math.sin(antiaim.ang) * 90
        pcall(function() root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(yaw), 0) end)
    elseif CFG.antiaimMode == "Spin" then
        antiaim.ang = antiaim.ang + CFG.antiaimSpeed * dt * 30
        pcall(function() root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(antiaim.ang % 360), 0) end)
    elseif CFG.antiaimMode == "Static" then
        pcall(function() root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(180), 0) end)
    end
end

local fakelagGhosts = {}
local function clearFakelagGhosts()
    for _, g in ipairs(fakelagGhosts) do if g.Part then g.Part:Destroy() end end
    fakelagGhosts = {}
end

local function fakelagStep(dt)
    if not CFG.fakelagEnabled then
        if #fakelagGhosts > 0 then clearFakelagGhosts() end
        return
    end
    if not root then return end
    fakelag.timer = fakelag.timer + dt
    if fakelag.timer >= CFG.fakelagAmount then
        fakelag.timer = 0
        if CFG.fakelagViz then
            local g = new("Part", {
                Size = Vector3.new(2, 5, 1),
                CFrame = root.CFrame,
                Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
                Transparency = 0.6,
                Color = Color3.fromHex(CFG.fakelagVizColor),
                Material = Enum.Material.Neon,
                Parent = Workspace
            })
            table.insert(fakelagGhosts, { Part = g, Time = os.clock() })
        end
    end
    local now = os.clock()
    for i = #fakelagGhosts, 1, -1 do
        local ghost = fakelagGhosts[i]
        if now - ghost.Time > 1.5 then
            if ghost.Part then ghost.Part:Destroy() end
            table.remove(fakelagGhosts, i)
        else
            local alpha = 1 - (now - ghost.Time) / 1.5
            if ghost.Part then ghost.Part.Transparency = 1 - alpha * 0.4 end
        end
    end
end

local function autododgeStep(dt)
    if not CFG.autododgeEnabled or not root then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and targetable(p) then
            local _, _, r = getChar(p)
            if r then
                local delta = root.Position - r.Position
                local dist = delta.Magnitude
                if dist < CFG.autododgeRange and dist > 0.1 then
                    root.CFrame = root.CFrame + delta.Unit * (CFG.autododgeRange - dist) * dt * 3
                end
            end
        end
    end
end

local function spin360Step(dt)
    if not CFG.spin360Enabled then return end
    spin360.ang = spin360.ang + CFG.spin360Speed * dt
    Camera.CFrame = CFrame.Angles(0, math.rad(spin360.ang), 0) * CFrame.new(0, 0, 10)
end

-- movement
local function movementStep(dt)
    if flyOn and CFG.flyEnabled then
        if not UIS:GetFocusedTextBox() then
            local cf = Camera.CFrame
            local function k(code) return UIS:IsKeyDown(code) and 1 or 0 end
            local f = k(Enum.KeyCode.W) - k(Enum.KeyCode.S)
            local rr = k(Enum.KeyCode.D) - k(Enum.KeyCode.A)
            local u = k(Enum.KeyCode.Space) - k(Enum.KeyCode.LeftControl)
            local dir = cf.LookVector * f + cf.RightVector * rr + Vector3.yAxis * u
            root.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * CFG.flySpeed or Vector3.zero
        end
    elseif CFG.speedEnabled and speedHeld then
        local extra = math.max(0, CFG.speedValue - hum.WalkSpeed)
        if hum.MoveDirection.Magnitude > 0 and extra > 0 then
            root.CFrame = root.CFrame + hum.MoveDirection * extra * dt
        end
    end
    if CFG.bhop and UIS:IsKeyDown(Enum.KeyCode.Space) and not UIS:GetFocusedTextBox() and hum.FloorMaterial ~= Enum.Material.Air then
        hum.Jump = true
    end
end

local function doLaunch()
    if not CFG.launchEnabled or not root or not hum or hum.Health <= 0 then return end
    if os.clock() - lastLaunch < CFG.launchCooldown then return end
    lastLaunch = os.clock()
    local v = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(v.X, CFG.launchPower, v.Z)
end

local function onDeath(p, h)
    if unloaded then return end
    local killer
    local tag = h:FindFirstChild("creator")
    if tag and tag:IsA("ObjectValue") and typeof(tag.Value) == "Instance" and tag.Value:IsA("Player") then killer = tag.Value end
    if not killer and p ~= LP and engaged[p] and os.clock() - engaged[p] < 1.2 then killer = LP end
    if killer == p then killer = nil end
    pushKillFeed(killer, p)
    if killer == LP and p ~= LP then showPopup("ELIMINATED", p.Name, T.accent) end
end
local function hookPlayer(p)
    local function onChar(c)
        local h = c:WaitForChild("Humanoid", 10)
        if h then h.Died:Connect(function() onDeath(p, h) end) end
    end
    track(p.CharacterAdded:Connect(function(c) task.spawn(onChar, c) end))
    if p.Character then task.spawn(onChar, p.Character) end
end

local esp = {}
local function clearEsp(p)
    local e = esp[p]
    if e then
        if e.hl then e.hl:Destroy() end
        if e.bb then e.bb:Destroy() end
        esp[p] = nil
    end
end
local function espStep()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c, h, r = getChar(p)
            if CFG.espEnabled and c then
                local e = esp[p]
                if not e or e.char ~= c then
                    clearEsp(p)
                    e = { char = c }
                    esp[p] = e
                    e.hl = new("Highlight", { Adornee = c, FillTransparency = 0.75, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, c)
                    e.bb = new("BillboardGui", { Adornee = r, AlwaysOnTop = true, Size = UDim2.fromOffset(160, 28), StudsOffset = Vector3.new(0, -3.4, 0), MaxDistance = 1500, LightInfluence = 0 }, gui)
                    e.txt = new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, RichText = true, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4 }, e.bb)
                end
                local col = isFriend(p) and Color3.fromHex("55ff88") or Color3.fromHex(CFG.espColor)
                e.hl.Enabled = CFG.espBoxes
                e.hl.FillColor = col; e.hl.OutlineColor = col
                e.bb.Enabled = CFG.espNames
                e.txt.Text = string.format('%s  <font color="#55ff88">%d</font>', p.Name, math.floor(h.Health))
            else
                clearEsp(p)
            end
        end
    end
end

local markers = {}
local function destroyMarker(l)
    local m = markers[l]
    if m then m.gui:Destroy(); markers[l] = nil end
end
local function makeMarker(entry, hrp)
    local color = Color3.fromHex(entry.color)
    local g = new("BillboardGui", { Adornee = hrp, AlwaysOnTop = true, Size = UDim2.fromOffset(160, 48), StudsOffset = Vector3.new(0, 3.6, 0), MaxDistance = math.huge, LightInfluence = 0 }, gui)
    local icon = new("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0.5, -6, 0, 2), Rotation = 45, BackgroundColor3 = color, BorderSizePixel = 0 }, g)
    local name = new("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 17), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = color, TextStrokeTransparency = 0.5 }, g)
    local dist = new("TextLabel", { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 32), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.text, TextStrokeTransparency = 0.5 }, g)
    return { gui = g, hrp = hrp, icon = icon, name = name, dist = dist }
end
local function syncMarkers()
    local alive = {}
    if CFG.friendMarkers then
        for _, e in ipairs(CFG.friends) do
            local l = e.name:lower()
            local p = findPlayerByName(e.name)
            local r = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if p and r then
                alive[l] = true
                local m = markers[l]
                if not m or m.hrp ~= r then destroyMarker(l); m = makeMarker(e, r); markers[l] = m end
                local col = Color3.fromHex(e.color)
                m.icon.BackgroundColor3 = col; m.name.TextColor3 = col
                m.name.Text = e.tag ~= "" and (e.tag .. " · " .. p.Name) or p.Name
            end
        end
    end
    for l in pairs(markers) do if not alive[l] then destroyMarker(l) end end
end
local function markerStep()
    for _, m in pairs(markers) do
        if m.hrp and m.hrp.Parent then
            local d = (Camera.CFrame.Position - m.hrp.Position).Magnitude
            local a = math.clamp((d - 12) / (250 - 12), 0, 1)
            local tr = math.min(CFG.markerFade, 0.95) * (1 - a)
            m.icon.BackgroundTransparency = tr
            m.name.TextTransparency = tr; m.name.TextStrokeTransparency = math.min(1, 0.5 + tr * 0.5)
            m.dist.TextTransparency = tr; m.dist.TextStrokeTransparency = math.min(1, 0.5 + tr * 0.5)
            m.dist.Text = math.floor(d) .. " m"
        end
    end
end

