-- ступенчатый телепорт (античит-обход)
local function stepTeleport(targetPos)
    if not root then return end
    local startPos = root.Position
    local delta = targetPos - startPos
    local distance = delta.Magnitude
    if distance < 1 then
        root.CFrame = CFrame.new(targetPos)
        return
    end
    local steps = math.max(1, math.floor(distance / 3))
    local stepVec = delta / steps
    for i = 1, steps do
        if unloaded or not root then return end
        root.CFrame = CFrame.new(startPos + stepVec * i)
        RunService.Heartbeat:Wait()
    end
end

local function stopMace(silent)
    if mace.active then
        mace.active = false
        mace.target = nil
        mace.stage = "idle"
        if not silent then toast("AUTO-MACE", "stopped", T.dim) end
    end
end

local function startMace()
    if not CFG.maceEnabled then return end
    if mace.active then stopMace() return end
    local t = pickTarget(false)
    if not t then toast("AUTO-MACE", "no targets", T.bad) return end
    mace.target = t
    mace.active = true
    mace.stage = "above"
    mace.timer = 0
    local _, hum2, hrp = getChar(t)
    if not hrp then mace.active = false return end
    stepTeleport(hrp.Position + Vector3.new(0, CFG.maceHeight, 0))
    mace.lastHealth[t] = hum2.Health
    mace.stage = "descending"
    toast("AUTO-MACE", "target: " .. t.Name, T.accent)
    if CFG.maceSound then playSound(CFG.maceSoundId, 1.3, 0.5) end
end

local function maceStep(dt)
    if not mace.active or not mace.target or not root then return end
    local _, targetHum, targetHrp = getChar(mace.target)
    if not targetHrp or targetHum.Health <= 0 then
        mace.kills = mace.kills + 1
        if CFG.maceSound then playSound(CFG.maceSoundId, 1, 1) end
        toast("AUTO-MACE", "KILL #" .. mace.kills, T.good)
        local n = CFG.combatAutoNext and pickTarget(false)
        if n and n ~= mace.target then
            mace.target = n
            mace.stage = "above"
            mace.timer = 0
            local _, _, r = getChar(n)
            if r then
                stepTeleport(r.Position + Vector3.new(0, CFG.maceHeight, 0))
                mace.lastHealth[n] = 100
                mace.stage = "descending"
            end
        else
            stopMace()
        end
        return
    end
    engaged[mace.target] = os.clock()

    if CFG.maceAim then
        aimAt(targetHrp.Position, 0.4 * dt * 60)
    end

    if mace.stage == "descending" then
        local myPos = root.Position
        local targetPos = targetHrp.Position + Vector3.new(0, 0.5, 0)
        local delta = targetPos - myPos
        local dist = delta.Magnitude
        if dist <= CFG.maceHitRange then
            doAttack(mace.target)
            mace.timer = 0
            mace.stage = "returning"
        else
            local speed = math.max(20, dist / 0.1)
            root.CFrame = CFrame.new(myPos + delta.Unit * math.min(dist, speed * dt))
        end
    end

    if mace.stage == "returning" then
        mace.timer = mace.timer + dt
        if mace.timer >= CFG.maceDelay then
            local _, _, newHrp = getChar(mace.target)
            if newHrp then
                stepTeleport(newHrp.Position + Vector3.new(0, CFG.maceHeight, 0))
                mace.stage = "descending"
            else
                stopMace()
            end
        end
    end
end

-- ============================================================
-- AUTO-CRIT (подход → прыжок 5 → удар → кружение)
-- ============================================================

local function stopCrit(silent)
    if crit.active then
        crit.active = false
        crit.target = nil
        crit.stage = "idle"
        if not silent then toast("AUTO-CRIT", "stopped", T.dim) end
    end
end

local function startCrit()
    if not CFG.critEnabled then return end
    if crit.active then stopCrit() return end
    stopMace(true)
    local t = pickTarget(false)
    if not t then toast("AUTO-CRIT", "no targets", T.bad) return end
    crit.target = t
    crit.active = true
    crit.stage = "approach"
    crit.timer = 0
    crit.angle = 0
    toast("AUTO-CRIT", "target: " .. t.Name, T.accent)
    if CFG.maceSound then playSound(CFG.maceSoundId, 1.3, 0.5) end
end

local function critStep(dt)
    if not crit.active or not crit.target or not root or not hum then return end
    local _, targetHum, targetHrp = getChar(crit.target)
    if not targetHrp or targetHum.Health <= 0 then
        local n = CFG.combatAutoNext and pickTarget(false)
        if n and n ~= crit.target then
            crit.target = n
            crit.stage = "approach"
            crit.timer = 0
            crit.angle = 0
        else
            stopCrit()
        end
        return
    end
    engaged[crit.target] = os.clock()

    if CFG.critAim then
        local look = CFrame.lookAt(Camera.CFrame.Position, targetHrp.Position)
        Camera.CFrame = Camera.CFrame:Lerp(look, math.clamp(0.4 * 60 * dt, 0, 1))
    end

    if crit.stage == "approach" then
        local myPos = root.Position
        local targetPos = targetHrp.Position
        local delta = targetPos - myPos
        local dist = delta.Magnitude
        if dist > 6 then
            local speed = 45
            root.CFrame = CFrame.new(myPos + delta.Unit * math.min(dist, speed * dt))
        else
            crit.stage = "jump"
            crit.timer = 0
        end
    end

    if crit.stage == "jump" then
        root.CFrame = root.CFrame + Vector3.new(0, 5, 0)
        crit.timer = 0
        crit.stage = "wait"
    end

    if crit.stage == "wait" then
        crit.timer = crit.timer + dt
        if crit.timer >= CFG.critJumpDelay then
            doAttack(crit.target)
            crit.stage = "spin"
            crit.timer = 0
            crit.angle = 0
        end
    end

    if crit.stage == "spin" then
        crit.timer = crit.timer + dt
        crit.angle = crit.angle + CFG.critSpinSpeed * dt
        if crit.timer >= CFG.critSpinTime then
            local n = CFG.combatAutoNext and pickTarget(false)
            if n and n ~= crit.target then
                crit.target = n
                crit.stage = "approach"
                crit.timer = 0
                crit.angle = 0
            else
                stopCrit()
            end
        else
            local radius = CFG.critSpinRadius
            local rad = math.rad(crit.angle)
            local offset = Vector3.new(math.cos(rad) * radius, 0, math.sin(rad) * radius)
            local targetPos = targetHrp.Position + offset
            local delta = targetPos - root.Position
            root.CFrame = CFrame.new(root.Position + delta * math.clamp(8 * dt, 0, 1))
            local look = CFrame.lookAt(Camera.CFrame.Position, targetHrp.Position)
            Camera.CFrame = Camera.CFrame:Lerp(look, math.clamp(0.5 * 60 * dt, 0, 1))
        end
    end
end

