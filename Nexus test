local function slider(page, label, key, mn, mx, step, onChange)
    local f = row(page, 58)
    new("TextLabel", { Size = UDim2.new(0.65, 0, 0, 24), Position = UDim2.fromOffset(16, 6), BackgroundTransparency = 1, Text = label, TextColor3 = T.text, TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left }, f)
    local val = new("TextLabel", { Size = UDim2.new(0.3, 0, 0, 24), Position = UDim2.new(0.7, -16, 0, 6), BackgroundTransparency = 1, TextColor3 = T.accent, TextSize = 13, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right }, f)
    local track = new("Frame", { Size = UDim2.new(1, -32, 0, 8), Position = UDim2.fromOffset(16, 40), BackgroundColor3 = T.panel, BorderSizePixel = 0 }, f)
    corner(track, 4)
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.accent, BorderSizePixel = 0 }, track)
    corner(fill, 4)
    local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, track)
    corner(knob, 8)
    local hit = new("TextButton", { Size = UDim2.new(1, -32, 0, 26), Position = UDim2.fromOffset(16, 30), BackgroundTransparency = 1, Text = "" }, f)
    local function fmt(v) if step >= 1 then return tostring(math.floor(v + 0.5)) end return string.format("%.2f", v) end
    local function setValue(v, fire)
        v = math.clamp(math.floor(v / step + 0.5) * step, mn, mx)
        CFG[key] = v
        local r = (v - mn) / (mx - mn)
        fill.Size = UDim2.new(r, 0, 1, 0); knob.Position = UDim2.new(r, -8, 0.5, -8); val.Text = fmt(v)
        if fire and onChange then onChange(v) end
    end
    setValue(CFG[key], false)
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            activeDrag = function(x)
                local r = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                setValue(mn + r * (mx - mn), true)
            end
            activeDrag(i.Position.X)
        end
    end)
    controls[key] = function(v) setValue(v, true) end
end

