local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function isVisible(c, part)
    rayParams.FilterDescendantsInstances = { LP.Character }
    local o = Camera.CFrame.Position
    local res = Workspace:Raycast(o, part.Position - o, rayParams)
    return res == nil or res.Instance:IsDescendantOf(c)
end

local function scoreTarget(p, c, r)
    if CFG.targetPrio == "lowest_hp" then
        local _, h = getChar(p)
        return h and h.Health or 9999
    elseif CFG.targetPrio == "in_crosshair" then
        local v, on = Camera:WorldToViewportPoint(r.Position)
        if not on then return 99999 end
        local vp = Camera.ViewportSize / 2
        return (Vector2.new(v.X, v.Y) - vp).Magnitude
    end
    return (r.Position - root.Position).Magnitude
end

local function pickTarget(useFov, exclude)
    if not root then return end
    local best, bestScore
    local vp = Camera.ViewportSize / 2
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= exclude and targetable(p) then
            local c, _, r = getChar(p)
            if r then
                local d = (r.Position - root.Position).Magnitude
                if d <= CFG.camRange then
                    local score, ok = scoreTarget(p, c, r), true
                    if useFov then
                        local v, on = Camera:WorldToViewportPoint(r.Position)
                        local sd = (Vector2.new(v.X, v.Y) - vp).Magnitude
                        ok = on and sd <= CFG.fovRadius
                        score = sd
                    end
                    if ok and CFG.camVisible and not isVisible(c, r) then ok = false end
                    if ok and (not bestScore or score < bestScore) then best, bestScore = p, score end
                end
            end
        end
    end
    return best
end

-- base64
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64LOOK = {}
for i = 1, 64 do B64LOOK[B64:sub(i, i)] = i - 1 end
local function b64encode(d)
    local o = {}
    for i = 1, #d, 3 do
        local a, b, c = string.byte(d, i, i + 2)
        local n = a * 65536 + (b or 0) * 256 + (c or 0)
        local c1 = math.floor(n / 262144) % 64
        local c2 = math.floor(n / 4096) % 64
        local c3 = math.floor(n / 64) % 64
        local c4 = n % 64
        o[#o + 1] = B64:sub(c1 + 1, c1 + 1) .. B64:sub(c2 + 1, c2 + 1)
            .. (b and B64:sub(c3 + 1, c3 + 1) or "=") .. (c and B64:sub(c4 + 1, c4 + 1) or "=")
    end
    return table.concat(o)
end
local function b64decode(s)
    s = s:gsub("[^%w%+/=]", "")
    local o = {}
    for i = 1, #s, 4 do
        local c1, c2, c3, c4 = s:sub(i, i), s:sub(i + 1, i + 1), s:sub(i + 2, i + 2), s:sub(i + 3, i + 3)
        local n = (B64LOOK[c1] or 0) * 262144 + (B64LOOK[c2] or 0) * 4096 + (B64LOOK[c3] or 0) * 64 + (B64LOOK[c4] or 0)
        o[#o + 1] = string.char(math.floor(n / 65536) % 256)
        if c3 ~= "=" and c3 ~= "" then o[#o + 1] = string.char(math.floor(n / 256) % 256) end
        if c4 ~= "=" and c4 ~= "" then o[#o + 1] = string.char(n % 256) end
    end
    return table.concat(o)
end

