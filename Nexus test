local function doAttack(target)
    local remote = ReplicatedStorage:FindFirstChild("NexusAttack")
    if remote and remote:IsA("RemoteEvent") then
        if target then remote:FireServer(target) end
        return
    end
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function aimAt(pos, a)
    local cf = CFrame.lookAt(Camera.CFrame.Position, pos)
    Camera.CFrame = Camera.CFrame:Lerp(cf, math.clamp(a, 0, 1))
end

local function lockRelease(silent)
    if lock.active and not silent then toast("TARGET", "lock released", T.dim) end
    lock.active = false; lock.target = nil
end
local function lockAcquire()
    local t = pickTarget(CFG.camUseFov)
    if t then
        lock.active = true; lock.target = t
        local _, _, r = getChar(t)
        local d = (r and root) and math.floor((r.Position - root.Position).Magnitude) or 0
        toast("TARGET LOCKED", t.Name .. "  ·  " .. d .. "m", T.accent)
        playSound(CFG.maceSoundId, 1.5, 0.5)
    else
        toast("TARGET", "no target", T.bad)
    end
end

local function lockStep(dt)
    local t = lock.target
    local c, _, r = nil, nil, nil
    if t and targetable(t) then c, _, r = getChar(t) end
    if not r then
        if CFG.combatAutoNext and (CFG.camMode == "Toggle" or camHeld) then
            lock.active = false; lock.target = nil
            lockAcquire()
        else
            lockRelease(true)
        end
        return
    end
    engaged[t] = os.clock()
    local part = c:FindFirstChild(CFG.camPart) or r
    local pos = part.Position + r.AssemblyLinearVelocity * CFG.camPredict
    aimAt(pos, CFG.camSmooth * dt * 60)
end

