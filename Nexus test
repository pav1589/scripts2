-- CONFIG
local function exportCfg()
    local d = {}
    for k, v in pairs(CFG) do
        if k == "friends" then
            if #v > 0 then d.friends = v end
        elseif v ~= DEFAULTS[k] then
            d[k] = v
        end
    end
    return "NXS5:" .. b64encode(HttpService:JSONEncode(d))
end
local function applyCfg(data)
    if type(data) ~= "table" then return false end
    for k, v in pairs(data) do
        if k == "friends" then
            if type(v) == "table" then
                CFG.friends = {}
                for _, e in ipairs(v) do
                    if type(e) == "table" and type(e.name) == "string" then
                        local col = PALETTE[1]
                        if type(e.color) == "string" and pcall(Color3.fromHex, e.color) then col = e.color end
                        table.insert(CFG.friends, { name = e.name:sub(1, 20), tag = tostring(e.tag or "FRIEND"):sub(1, 14), color = col })
                    end
                end
                rebuildFriendSet(); refreshFriends(); syncMarkers()
            end
        elseif DEFAULTS[k] ~= nil and type(v) == type(DEFAULTS[k]) and controls[k] then
            if k:sub(-3) == "Key" then
                local ok, kc = pcall(function() return Enum.KeyCode[v] end)
                if ok and kc then controls[k](v) end
            elseif k:sub(-5) == "Color" then
                if pcall(Color3.fromHex, v) then controls[k](v) end
            else
                controls[k](v)
            end
        end
    end
    return true
end
local function importCfg(str)
    str = (str or ""):gsub("%s+", "")
    if str:sub(1, 5) ~= "NXS5:" then return false end
    local ok, json = pcall(b64decode, str:sub(6))
    if not ok then return false end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, json)
    if not ok2 or type(data) ~= "table" then return false end
    local base = copyTable(DEFAULTS); base.friends = nil
    applyCfg(base)
    if type(data.friends) ~= "table" then data.friends = {} end
    return applyCfg(data)
end

