-- ============================================================
-- HTTP LOADER (под разные executor'ы)
-- ============================================================

local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and res and #res > 0 then return res end
    if request then
        local ok2, r = pcall(function() return request({ Url = url, Method = "GET" }).Body end)
        if ok2 and r then return r end
    end
    if http_request then
        local ok3, r = pcall(function() return http_request({ Url = url, Method = "GET" }).Body end)
        if ok3 and r then return r end
    end
    if syn and syn.request then
        local ok4, r = pcall(function() return syn.request({ Url = url, Method = "GET" }).Body end)
        if ok4 and r then return r end
    end
    return nil
end

local function loadCode(code)
    if not code then return nil, "empty code" end
    if loadstring then
        local ok, fn = pcall(loadstring, code)
        if ok and fn then return fn end
    end
    if load then
        local ok, fn = pcall(load, code)
        if ok and fn then return fn end
    end
    return nil, "loadstring unavailable"
end

