local loading = false

local function setStatus(text, color)
    status.Text = text
    status.TextColor3 = color or Color3.fromRGB(138, 144, 166)
end

local function fadeOutAndDestroy()
    local tween = TweenService:Create(win, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    })
    tween:Play()

    -- прозрачность всех детей через CanvasGroup эффект — но проще просто удалить после
    TweenService:Create(header, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(headerFix, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(gameBtn, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(gbIcon, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()

    -- фон тоже исчезает
    TweenService:Create(bg, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()

    -- удаляем всё через 0.35 сек
    task.delay(0.35, function()
        gui:Destroy()
    end)
end

local function launchScript()
    if loading then return end
    loading = true

    setStatus("Connecting to NEXUS server...", Color3.fromRGB(110, 160, 255))
    gameBtn.AutoButtonColor = false
    gameBtn.BackgroundColor3 = Color3.fromRGB(40, 44, 60)
    gbArrow.Text = "⏳"

    -- 1. Скачиваем код
    task.spawn(function()
        local code = httpGet(SCRIPT_URL)
        if not code or #code < 100 then
            loading = false
            setStatus("Failed to download script", Color3.fromRGB(255, 70, 85))
            gameBtn.BackgroundColor3 = Color3.fromRGB(27, 29, 37)
            gbArrow.Text = "→"
            return
        end

        setStatus("Script downloaded (" .. math.floor(#code / 1024) .. " KB). Loading...", Color3.fromRGB(85, 255, 136))

        -- 2. Компилируем
        local fn, err = loadCode(code)
        if not fn then
            loading = false
            setStatus("Compile error: " .. tostring(err), Color3.fromRGB(255, 70, 85))
            gameBtn.BackgroundColor3 = Color3.fromRGB(27, 29, 37)
            gbArrow.Text = "→"
            return
        end

        -- 3. Запускаем в отдельном потоке, чтобы не блокировать
        task.spawn(function()
            local ok, runErr = pcall(fn)
            if not ok then
                loading = false
                setStatus("Runtime error: " .. tostring(runErr):sub(1, 80), Color3.fromRGB(255, 70, 85))
                gameBtn.BackgroundColor3 = Color3.fromRGB(27, 29, 37)
                gbArrow.Text = "→"
                return
            end
            -- всё ок — скрипт загружен
            setStatus("Loaded. Closing launcher...", Color3.fromRGB(85, 255, 136))
            gbArrow.Text = "✓"
            task.wait(0.25)
            fadeOutAndDestroy()
        end)
    end)
end

gameBtn.MouseButton1Click:Connect(launchScript)

