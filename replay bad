    ToggleMenu = Enum.KeyCode.RightAlt,
}

-- ==================== STATE ====================
local isRecording   = false
local recordStart   = 0
local lastTick      = 0
local recording     = nil

local isPlaying     = false
local playbackStart = 0
local playbackIndex = 1
local activeClone   = nil
local cloneAnimator = nil
local activeTracks  = {}
local animEvents    = {}

-- ==================== UTIL ====================
local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Replay", Text = text, Duration = 3,
        })
    end)
    print("[Replay]", text)
end

local function getAnimator(plr)
    local char = plr.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    return hum:FindFirstChildOfClass("Animator")
end

-- ==================== ANIM HOOK ====================
local function hookAnimations()
    local animator = getAnimator(LocalPlayer)
    if not animator then return end
    animator.AnimationPlayed:Connect(function(track)
        if not isRecording then return end
        if not Config.RecordAnimations then return end
        local anim = track.Animation
        if not anim then return end
        table.insert(animEvents, {
            time = tick() - recordStart,
            animation = anim,
            speed = track.Speed,
            weight = track.WeightTarget,
        })
    end)
end

-- ==================== RECORD ====================
local function startRecording()
    if isRecording then return end
    if not LocalPlayer.Character then
        notify("нет персонажа")
        return
    end
    isRecording = true
    recordStart = tick()
    lastTick = 0
    recording = {
        frames = {},
        anims = {},
        items = {},
        duration = 0,
    }
    animEvents = {}

    -- предзапись предметов в руках
    if Config.RecordItems then
        local char = LocalPlayer.Character
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") then
                local ok, c = pcall(function() return t:Clone() end)
                if ok and c then
                    c.Parent = nil
                    recording.items[t.Name] = c
                end
            end
        end
    end

    hookAnimations()
    notify("● запись начата")
end

local function stopRecording()
    if not isRecording then return end
    isRecording = false
    if recording then
        recording.anims = animEvents
        recording.duration = tick() - recordStart
        local ic = 0
        for _ in pairs(recording.items) do ic = ic + 1 end
        notify(string.format("■ запись: %.2fс | %d кадров | %d анимаций | %d предметов",
            recording.duration, #recording.frames, #recording.anims, ic))
    end
end

local function captureFrame()
    if not isRecording then return end
    local now = tick() - recordStart
    if now - lastTick < Config.RecordInterval then return end
    lastTick = now

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")

    local face
    if Config.RecordFace and head then
        for _, d in ipairs(head:GetChildren()) do
            if d:IsA("Decal") then face = d.Texture break end
        end
    end

    local tools = {}
    if Config.RecordItems then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") then
                table.insert(tools, t.Name)
                if not recording.items[t.Name] then
                    local ok, c = pcall(function() return t:Clone() end)
                    if ok and c then
                        c.Parent = nil
                        recording.items[t.Name] = c
                    end
                end
            end
        end
    end

    table.insert(recording.frames, {
        time = now,
        cframe = hrp.CFrame,
        headCFrame = head and head.CFrame or nil,
        health = hum and hum.Health or 100,
        face = face,
        tools = tools,
    })
end

-- ==================== MANUAL CLONE ====================
local function manualClone(char)
    if not char then return nil end
    local model = Instance.new("Model")
    model.Name = "ReplayClone_" .. tostring(math.random(1000, 9999))
    model.Archivable = true

    local map = {}

    -- BasePart / Decal / Mesh
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local np
            if p:IsA("MeshPart") then
                np = Instance.new("MeshPart")
                np.MeshId = p.MeshId
                np.TextureID = p.TextureID
            else
                np = Instance.new("Part")
                pcall(function() np.Shape = p.Shape end)
            end
            np.Name = p.Name
            np.Size = p.Size
            np.Color = p.Color
            np.Material = p.Material
            np.Transparency = p.Transparency
            np.Reflectance = p.Reflectance
            np.CanCollide = false
            np.CanQuery = false
            np.CanTouch = false
            np.Anchored = false
            np.Massless = true
            np.CFrame = p.CFrame
            np.Parent = model
            map[p] = np

        elseif p:IsA("Decal") then
            local nd = Instance.new("Decal")
            nd.Name = p.Name
            nd.Texture = p.Texture
            nd.Face = p.Face
            nd.Transparency = p.Transparency
            map[p] = nd

        elseif p:IsA("SpecialMesh") or p:IsA("BlockMesh")
            or p:IsA("CylinderMesh") or p:IsA("SphereMesh") then
            local nm = p:Clone()
            map[p] = nm
        end
    end

    -- вкладываем Decal и Mesh в их Part
    for old, new in pairs(map) do
        if new:IsA("Decal") or new:IsA("DataModelMesh") then
            local newParent = map[old.Parent]
            if newParent and newParent:IsA("BasePart") then
                new.Parent = newParent
            end
        end
    end

    -- PrimaryPart + сварка
    local hrp = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChildWhichIsA("BasePart")

    if hrp then
        model.PrimaryPart = hrp
        hrp.Anchored = Config.CloneAnchored
        for _, p in ipairs(model:GetChildren()) do
            if p:IsA("BasePart") and p ~= hrp then
                local w = Instance.new("WeldConstraint")
                w.Part0 = hrp
                w.Part1 = p
                w.Parent = p
            end
        end
    end

    local hum = Instance.new("Humanoid")
    hum.Parent = model
    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    hum.PlatformStand = true
    hum.AutoRotate = false

    return model
end

-- ==================== SPAWN CLONE ====================
local function destroyClone()
    if activeClone then
        pcall(function() activeClone:Destroy() end)
        activeClone = nil
    end
    activeTracks = {}
    cloneAnimator = nil
end

local function spawnClone()
    destroyClone()
    local char = LocalPlayer.Character
    if not char or not char.Parent then
        notify("персонаж недоступен")
        return nil
    end

    -- Archivable на оригинале
    local oldArch = char.Archivable
    char.Archivable = true
    for _, d in ipairs(char:GetDescendants()) do
        pcall(function() d.Archivable = true end)
    end

    local ok, clone = pcall(function() return char:Clone() end)
    char.Archivable = oldArch

    local usedManual = false
    if not ok or not clone then
        notify("Clone() не сработал — ручная сборка")
        clone = manualClone(char)
        usedManual = true
        if not clone then
            notify("ручная сборка упала")
            return nil
        end
    else
        clone.Name = "ReplayClone_" .. tostring(math.random(1000, 9999))
        clone.Archivable = true

        -- вырезаем код и звук
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript")
                or d:IsA("Sound") or d:IsA("SoundGroup")
                or d:IsA("ForceField") then
                pcall(function() d:Destroy() end)
            end
        end

        -- удаляем Motor6D — ломают позиции при Anchored
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Motor6D") then
                pcall(function() d:Destroy() end)
            end
        end

        -- якорь только на HRP, остальные варятся
        local hrp = clone:FindFirstChild("HumanoidRootPart")
        if hrp then
            clone.PrimaryPart = hrp
            hrp.Anchored = Config.CloneAnchored

            -- сначала сохраняем все CFrame
            local cframes = {}
            for _, p in ipairs(clone:GetDescendants()) do
                if p:IsA("BasePart") then
                    cframes[p] = p.CFrame
                end
            end

            -- потом якорим, ставим обратно и варим
            for _, p in ipairs(clone:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.CanQuery = false
                    p.CanTouch = false
                    p.Massless = true
                    p.Transparency = math.clamp(p.Transparency + Config.CloneTransparency, 0, 1)

                    if p ~= hrp then
                        p.Anchored = false
                        p.CFrame = cframes[p]
                        local w = Instance.new("WeldConstraint")
                        w.Part0 = hrp
                        w.Part1 = p
                        w.Parent = p
                    end
                elseif p:IsA("Decal") then
                    p.Transparency = math.clamp(p.Transparency + Config.CloneTransparency, 0, 1)
                end
            end
        else
            -- фоллбэк: если HRP нет, якорим все
            for _, p in ipairs(clone:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.Anchored = Config.CloneAnchored
                    p.Transparency = math.clamp(p.Transparency + Config.CloneTransparency, 0, 1)
                end
            end
        end
    end

    -- если ручная сборка: применить прозрачность
    if usedManual then
        for _, p in ipairs(clone:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Transparency = math.clamp(p.Transparency + Config.CloneTransparency, 0, 1)
            elseif p:IsA("Decal") then
                p.Transparency = math.clamp(p.Transparency + Config.CloneTransparency, 0, 1)
            end
        end
    end

    -- humanoid + новый animator
    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.AutoRotate = false
        hum.PlatformStand = true
        local oldAnim = hum:FindFirstChildOfClass("Animator")
        if oldAnim then oldAnim:Destroy() end
        cloneAnimator = Instance.new("Animator")
        cloneAnimator.Parent = hum
    end

    -- лицо из записи
    if Config.RecordFace and recording and recording.frames[1] then
        local faceTex
        for _, f in ipairs(recording.frames) do
            if f.face then faceTex = f.face break end
        end
        if faceTex then
            local head = clone:FindFirstChild("Head")
            if head then
                for _, d in ipairs(head:GetChildren()) do
                    if d:IsA("Decal") then d:Destroy() end
                end
                local dec = Instance.new("Decal")
                dec.Name = "face"
                dec.Texture = faceTex
                dec.Face = Enum.NormalId.Front
                dec.Parent = head
            end
        end
    end

    clone.Parent = workspace
    return clone
end

-- ==================== ITEMS ====================
local function applyTools(names)
    if not activeClone or not recording then return end
    if not Config.RecordItems then return end

    for _, t in ipairs(activeClone:GetChildren()) do
        if t:IsA("Tool") then t:Destroy() end
    end

    local hum = activeClone:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    for _, name in ipairs(names) do
        local tmpl = recording.items[name]
        if tmpl then
            local ok, item = pcall(function() return tmpl:Clone() end)
            if ok and item then
                item.Parent = activeClone
                pcall(function() hum:EquipTool(item) end)
                -- если EquipTool не сработал — сварим вручную к правой руке
                task.wait(0.05)
                if item.Parent == activeClone or item.Parent == hum then
                    -- уже экипирован, ок
                else
                    local rightHand = activeClone:FindFirstChild("RightHand")
                        or activeClone:FindFirstChild("Right Arm")
                    local handle = item:FindFirstChild("Handle")
                    if rightHand and handle then
                        handle.CFrame = rightHand.CFrame
                        local w = Instance.new("WeldConstraint")
                        w.Part0 = rightHand
                        w.Part1 = handle
                        w.Parent = handle
                    end
                    item.Parent = activeClone
                end
            end
        end
    end
end

-- ==================== PLAYBACK ====================
local function playAnim(anim, speed, weight)
    if not cloneAnimator then return end
    local ok, track = pcall(function() return cloneAnimator:LoadAnimation(anim) end)
    if ok and track then
        pcall(function()
            track.Priority = Enum.AnimationPriority.Action
            track:Play(0.1)
            track:AdjustSpeed(speed or 1)
            if weight then track:AdjustWeight(weight, 0.1) end
        end)
        activeTracks[anim] = track
    end
end

local function stopAllAnims()
    for _, t in pairs(activeTracks) do
        pcall(function() t:Stop(0.2) end)
    end
    activeTracks = {}
end

local function startPlayback()
    if not recording or #recording.frames == 0 then
        notify("нет записи")
        return
    end
    if isPlaying then stopPlayback() task.wait(0.05) end
    if isRecording then stopRecording() end

    activeClone = spawnClone()
    if not activeClone then return end

    for _, ev in ipairs(recording.anims) do ev._fired = false end
    activeClone:SetAttribute("_lastTools", "")

    isPlaying = true
    playbackStart = tick()
    playbackIndex = 1
    notify("▶ проигрывание начато")
end

local function stopPlayback()
    if not isPlaying then return end
    isPlaying = false
    stopAllAnims()
    if Config.AutoDelete then destroyClone() end
    notify("■ проигрывание остановлено")
end

local function updatePlayback()
    if not isPlaying then return end
    if not activeClone or not activeClone.Parent then isPlaying = false return end
    if not recording then isPlaying = false return end

    local elapsed = tick() - playbackStart
    local frames = recording.frames

    if elapsed >= recording.duration then
        if Config.Loop then
            playbackStart = tick()
            playbackIndex = 1
            stopAllAnims()
            for _, ev in ipairs(recording.anims) do ev._fired = false end
            activeClone:SetAttribute("_lastTools", "")
        else
            stopPlayback()
            return
        end
    end

    while playbackIndex < #frames and frames[playbackIndex + 1].time <= elapsed do
        playbackIndex = playbackIndex + 1
    end

    local cur = frames[playbackIndex]
    local nxt = frames[playbackIndex + 1]

    local cf
    if nxt then
        local dt = nxt.time - cur.time
        local a = (dt > 0) and ((elapsed - cur.time) / dt) or 0
        a = math.clamp(a, 0, 1)
        cf = cur.cframe:Lerp(nxt.cframe, a)
    else
        cf = cur.cframe
    end

    if cf then
        pcall(function() activeClone:PivotTo(cf) end)
    end

    if cur.headCFrame then
        local head = activeClone:FindFirstChild("Head")
        if head then pcall(function() head.CFrame = cur.headCFrame end) end
    end

    if Config.RecordItems and cur.tools then
        local joined = table.concat(cur.tools, ",")
        if activeClone:GetAttribute("_lastTools") ~= joined then
            activeClone:SetAttribute("_lastTools", joined)
            applyTools(cur.tools)
        end
    end

    if Config.RecordAnimations then
        for _, ev in ipairs(recording.anims) do
            if ev.time <= elapsed and not ev._fired then
                ev._fired = true
                playAnim(ev.animation, ev.speed, ev.weight)
            end
        end
    end
end

-- ==================== WIPE ====================
local function wipeEverything()
    if isRecording then pcall(stopRecording) end
    if isPlaying then pcall(stopPlayback) end
    pcall(destroyClone)
    pcall(stopAllAnims)
    recording = nil
    animEvents = {}
    activeTracks = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name:find("ReplayClone_") then
            pcall(function() obj:Destroy() end)
        end
    end
    local g = gethui and gethui() or CoreGui
    for _, c in ipairs(g:GetChildren()) do
        if c.Name == "LokeiiReplay" then
            pcall(function() c:Destroy() end)
        end
    end
    if getgenv().LokeiiReplay_Conn then
        pcall(function() getgenv().LokeiiReplay_Conn:Disconnect() end)
        getgenv().LokeiiReplay_Conn = nil
    end
    notify("☠ всё снесено")
end

