-- ==================== CONFIG ====================
local Config = {
    RecordInterval   = 0.033,
    CloneTransparency = 0.0,
    CloneAnchored    = true,
    AutoDelete       = false,
    Loop             = false,
    ShowHUD          = true,
    RecordAnimations = true,
    RecordFace       = true,
    RecordItems      = true,
}

