getgenv().LokeiiReplay_Conn = RunService.Heartbeat:Connect(function()
    if isRecording then captureFrame() end
    if isPlaying then updatePlayback() end

    if Config.ShowHUD then
        local parts = {}
        if isRecording then
            table.insert(parts, "● REC " .. string.format("%.1fс", tick() - recordStart))
        end
        if isPlaying then
            table.insert(parts, "▶ PLAY " .. string.format("%.1f/%.1f",
                tick() - playbackStart,
                recording and recording.duration or 0))
        end
        hud.Text = #parts > 0 and table.concat(parts, "  |  ") or ""
        hud.Visible = #parts > 0
    else
        hud.Visible = false
    end

    if recording then
        local ic = 0
        for _ in pairs(recording.items or {}) do ic = ic + 1 end
        recStatus.Text = string.format("кадров: %d | анимаций: %d | предметов: %d | %.2fс",
            #recording.frames, #(recording.anims or {}), ic, recording.duration)
    else
        recStatus.Text = "записи нет"
    end
    playStatus.Text = activeClone and ("клон: " .. activeClone.Name) or "клон: нет"
end)

